<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="390dp"
    android:layout_height="400dp"
    android:background="@drawable/panel_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView android:id="@+id/overlayStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Text2SCPI" android:textColor="@color/text_primary" android:textStyle="bold" />
        <EditText android:id="@+id/overlayInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="输入控制指令" android:imeOptions="actionSend" android:inputType="text" android:maxLines="2" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/overlaySend" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="识别" />
            <Button android:id="@+id/overlayConfirm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="确认" />
            <Button android:id="@+id/overlayCancel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="取消" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/overlayOpenScope" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="打开示波器" />
            <Button android:id="@+id/overlayCollapse" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="收起" />
            <Button android:id="@+id/overlayClose" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="彻底关闭" />
        </LinearLayout>
        <TextView android:id="@+id/overlayResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="9" android:minHeight="100dp" android:text="等待输入" android:textColor="@color/text_secondary" android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
