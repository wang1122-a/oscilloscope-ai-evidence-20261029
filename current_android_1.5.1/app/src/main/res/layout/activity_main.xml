<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text2SCPI Control"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_background"
            android:text="Service: STARTING\nModel: UNINITIALIZED\nTCP: DISCONNECTED"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/inputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="输入自然语言，例如：查询CH1的带宽"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="3"
            android:minHeight="52dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/sendButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="识别" />
            <Button android:id="@+id/confirmButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="确认发送" />
            <Button android:id="@+id/cancelButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:enabled="false" android:text="取消" />
            <Button android:id="@+id/overlayButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="悬浮控制" />
            <Button android:id="@+id/openScopeButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="打开示波器" />
        </LinearLayout>

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_background"
            android:minHeight="260dp"
            android:text="等待输入"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
