{
  "schema_version": 1,
  "policy_id": "scpi-semantic-grammar-v1.1.4-rnd",
  "normalization_rules": [
    "utf8_strict",
    "unicode_nfkc",
    "newline_lf",
    "collapse_horizontal_whitespace",
    "trim_outer_whitespace",
    "ascii_casefold_match_copy",
    "preserve_scpi_punctuation",
    "preserve_negation"
  ],
  "operation_terms": {
    "query": [
      "查询",
      "查看",
      "读取",
      "获取",
      "多少",
      "是什么"
    ],
    "set": [
      "设置",
      "设为",
      "调整",
      "改为",
      "切换到",
      "切换为"
    ],
    "action": [
      "执行",
      "清除",
      "重置",
      "保存",
      "使用当前"
    ]
  },
  "negation_terms": {
    "command_negation": [
      "不要",
      "别",
      "禁止",
      "无需执行"
    ],
    "uncertainty": [
      "是否",
      "能否",
      "可不可以"
    ],
    "state_off": [
      "关闭",
      "关掉",
      "禁用",
      "停止"
    ],
    "state_on": [
      "开启",
      "打开",
      "启用",
      "开始",
      "启动",
      "运行"
    ]
  },
  "number_grammar": {
    "ascii_integer": "[+-]?(?:0|[1-9][0-9]*)",
    "ascii_decimal": "[+-]?(?:0|[1-9][0-9]*)\\.[0-9]+",
    "ascii_scientific": "[+-]?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?[eE][+-]?[0-9]+",
    "chinese_digits": {
      "零": 0,
      "一": 1,
      "二": 2,
      "两": 2,
      "三": 3,
      "四": 4,
      "五": 5,
      "六": 6,
      "七": 7,
      "八": 8,
      "九": 9
    },
    "chinese_small_units": {
      "十": 10,
      "百": 100,
      "千": 1000
    },
    "chinese_large_units": {
      "万": 10000,
      "亿": 100000000
    },
    "engineering_multipliers": {
      "兆": {
        "multiplier": 1000000,
        "requires_formal_si_dimension_or_range_evidence": true
      }
    },
    "path_identifier_prefixes": [
      "CH",
      "REF",
      "AFG",
      "MATH",
      "FFT",
      "FILTER",
      "D",
      "BUS",
      "B",
      "通道",
      "总线",
      "滤波器"
    ],
    "decimal_backend": "decimal.Decimal",
    "lossless_only": true,
    "multiple_payload_numbers": "fail_closed",
    "ambiguous_multiplier": "fail_closed"
  },
