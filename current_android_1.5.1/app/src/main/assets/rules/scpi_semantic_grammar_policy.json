  "technical_token_patterns": [
    "\\*[A-Za-z]+\\??",
    "[A-Za-z][A-Za-z0-9]*(?::[A-Za-z][A-Za-z0-9]*(?:\\[[^\\]]+\\])?)*\\??",
    "(?:CH|REF|AFG|MATH|FFT|BUS|MEAS|SOURCE|D)[0-9]+"
  ],
  "term_derivation": {
    "minimum_operation_support": 3,
    "minimum_semantic_fragment_support": 2,
    "minimum_semantic_fragment_characters": 2,
    "maximum_semantic_fragment_characters": 12,
    "maximum_fragment_command_family_count": 1,
    "required_operation_purity": 1.0,
    "term_catalog_requires_unique_rebinding": true,
    "approved_language_can_add_deterministic_bound_fragments": true,
    "description_token_selection_requires_cross_evidence": true
  },
  "function_words": [
    "一个",
    "一下",
    "一次",
    "将",
    "把",
    "的",
    "当前",
    "进行",
    "设置为",
    "设为",
    "设成",
    "改成",
    "切换到",
    "切换为",
    "是否"
  ],
  "clarification": {
    "default_ttl_seconds": 300,
    "single_use": true,
    "max_missing_slots": 4
  },
  "candidate_filter_order": [
    "catalog_integrity",
    "implementation_voice_eligibility",
    "operation",
    "module_object",
    "property_action",
    "path_slot",
    "required_input_slot",
    "parameter_type",
    "enum_discrete_range_unit",
    "positive_evidence",
    "contradiction_negation",
    "schema_prevalidation",
    "serializer_prevalidation",
    "runtime_capability"
  ],
  "forbidden_sources": [
    "case_id",
    "gold_payload",
    "test",
    "challenge",
    "historical_model_error_map",
    "network",
    "second_model"
  ]
